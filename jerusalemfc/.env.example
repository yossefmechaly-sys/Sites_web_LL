DATABASE_URL=file:./jerusalemfc.db
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Compte admin de dev local, créé par npm run seed:dev-admin
DEV_ADMIN_EMAIL=dev@jerusalemfc.test
DEV_ADMIN_PASSWORD=

# Google Analytics 4, chargé seulement après consentement (vide = pas de mesure d'audience)
NEXT_PUBLIC_GA_ID=G-WHZBPE28NX

# Adresse publique du site (hreflang, liens canoniques)
NEXT_PUBLIC_SITE_URL=https://jerusalemfc.co.il

# Vidage du cache des pages après l'import des matchs (route /revalidate) : longue valeur aléatoire
REVALIDATE_SECRET=
# Adresse locale du serveur Next.js, utilisée par le script d'import
INTERNAL_URL=http://127.0.0.1:3100
